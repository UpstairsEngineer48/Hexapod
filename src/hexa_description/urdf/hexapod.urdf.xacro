        <origin xyz="0.015893 0 0.076364" rpy="0 -0.79606 0"/>
        <axis xyz="0 -1 0"/>
        <limit lower="-2.0" upper="0.5" effort="5" velocity="2"/>
    </joint>

    <!-- Coxa 6 -->
    <link name="${prefix}Coxa_6">
        <inertial>
            <origin xyz="0.000577862012579221 -0.0317727763355633 0.0354243258351977" rpy="0 0 0"/>
            <mass value="0.0582069863848159"/>
            <inertia ixx="2.09518881532946E-05" ixy="-5.83217113176353E-12" ixz="2.58985476936145E-06" iyy="1.97804446474373E-05" iyz="2.51053441650112E-06" izz="2.06393092896648E-05"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://${package_name}/meshes/Coxa_6.STL"/>
            </geometry>
            <material name="coxa_color"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://${package_name}/meshes/Coxa_6.STL"/>
            </geometry>
        </collision>
    </link>

    <joint name="${prefix}Joint6_1" type="revolute">
        <parent link="${prefix}Base"/>
        <child link="${prefix}Coxa_6"/>
        <origin xyz="-0.067149 0.11215 0.05285" rpy="1.5708 0 -2.5044"/>
        <axis xyz="0 -1 0"/>
        <limit lower="-1.5708" upper="1.5708" effort="5" velocity="2"/>
    </joint>

    <link name="${prefix}Femur_6">
        <inertial>
            <origin xyz="0.00675394593304171 -0.0355181598715529 0.0384080569020034" rpy="0 0 0"/>
            <mass value="0.107128889683649"/>
            <inertia ixx="5.14769513685849E-05" ixy="-1.39253820187571E-10" ixz="-6.28169057953268E-06" iyy="4.90722656194813E-05" iyz="2.45845148700639E-11" izz="1.71349930220452E-05"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://${package_name}/meshes/Femur_6.STL"/>
            </geometry>
            <material name="femur_color"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://${package_name}/meshes/Femur_6.STL"/>
            </geometry>
        </collision>
    </link>

    <joint name="${prefix}Joint6_2" type="revolute">
        <parent link="${prefix}Coxa_6"/>
        <child link="${prefix}Femur_6"/>
        <origin xyz="-0.03075 -0.03075 0.07" rpy="0 0 1.5708"/>
        <axis xyz="0 -1 0"/>
        <limit lower="-1.5708" upper="1.5708" effort="5" velocity="2"/>
    </joint>

    <link name="${prefix}Tibia_6">
        <inertial>
            <origin xyz="-0.0138676550200287 -0.0324549934835745 0.0624080741697963" rpy="0 0 0"/>
            <mass value="0.0754192670395059"/>
            <inertia ixx="8.21140496751916E-05" ixy="1.59843101322849E-08" ixz="3.75903641239812E-05" iyy="0.000101715600934306" iyz="2.38830021421716E-06" izz="4.78958781380929E-05"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://${package_name}/meshes/Tibia_6.STL"/>
            </geometry>
            <material name="tibia_color"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://${package_name}/meshes/Tibia_6.STL"/>
            </geometry>
        </collision>
    </link>

    <joint name="${prefix}Joint6_3" type="revolute">
        <parent link="${prefix}Femur_6"/>
        <child link="${prefix}Tibia_6"/>
        <origin xyz="0.013608 -0.00075 0.076804" rpy="0 -1.159 0"/>
        <axis xyz="0 -1 0"/>
        <limit lower="-2.0" upper="0.5" effort="5" velocity="2"/>
    </joint>

    <!-- ========================================== -->
    <!-- INVOKING TRANSMISSION MACROS FOR 6 LEGS    -->
    <!-- ========================================== -->
    <xacro:leg_transmission leg_num="1" prefix="${prefix}"/>
    <xacro:leg_transmission leg_num="2" prefix="${prefix}"/>
    <xacro:leg_transmission leg_num="3" prefix="${prefix}"/>
    <xacro:leg_transmission leg_num="4" prefix="${prefix}"/>
    <xacro:leg_transmission leg_num="5" prefix="${prefix}"/>
    <xacro:leg_transmission leg_num="6" prefix="${prefix}"/>
    <!-- ========================================== -->

    <gazebo>
        <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
        <odom_topic>odom</odom_topic>
        <odom_frame>odom</odom_frame>
        <tf_topic>tf</tf_topic>
        <robot_base_frame>base_footprint</robot_base_frame>
        </plugin>
    </gazebo>
    <gazebo>
        <plugin
            filename="libignition-gazebo-imu-system.so"
            name="ignition::gazebo::systems::Imu">
        </plugin>
    </gazebo>
    <!-- ========================================== -->
    <!-- ROS 2 CONTROL HARDWARE INTERFACE           -->
    <!-- ========================================== -->
    <ros2_control name="IgnitionSystem" type="system">
        <hardware>
            <plugin>ign_ros2_control/IgnitionSystem</plugin>
        </hardware>

        <!-- Macro to define the interfaces for a single leg -->
        <xacro:macro name="ros2_control_leg" params="leg_num prefix">
            <!-- Coxa -->
            <joint name="${prefix}Joint${leg_num}_1">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <!-- Femur -->
            <joint name="${prefix}Joint${leg_num}_2">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <!-- Tibia -->
            <joint name="${prefix}Joint${leg_num}_3">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
        </xacro:macro>

        <!-- Invoking the macro for all 6 legs -->
        <xacro:ros2_control_leg leg_num="1" prefix="${prefix}"/>
        <xacro:ros2_control_leg leg_num="2" prefix="${prefix}"/>
        <xacro:ros2_control_leg leg_num="3" prefix="${prefix}"/>
        <xacro:ros2_control_leg leg_num="4" prefix="${prefix}"/>
        <xacro:ros2_control_leg leg_num="5" prefix="${prefix}"/>
        <xacro:ros2_control_leg leg_num="6" prefix="${prefix}"/>
    </ros2_control>

    <!-- GAZEBO IGNITION ROS 2 CONTROL PLUGIN       -->
    <gazebo>
        <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
            <parameters>${config_dir}/config/controller.yaml</parameters>
        </plugin>
    </gazebo>
        
    <!-- ================= FOOT CONTACT SENSORS ================= -->

    <gazebo reference="${prefix}Tibia_1">
        <sensor name="contact_sensor_1" type="contact">
            <always_on>true</always_on>
            <update_rate>50</update_rate>
            <contact>
                <collision>collision</collision>
            </contact>
        </sensor>
    </gazebo>

    <gazebo reference="${prefix}Tibia_2">
        <sensor name="contact_sensor_2" type="contact">
            <always_on>true</always_on>
            <update_rate>50</update_rate>
            <contact>
                <collision>collision</collision>
            </contact>
        </sensor>
    </gazebo>

    <gazebo reference="${prefix}Tibia_3">
        <sensor name="contact_sensor_3" type="contact">
            <always_on>true</always_on>
            <update_rate>50</update_rate>
            <contact>
                <collision>collision</collision>
            </contact>
        </sensor>
    </gazebo>

    <gazebo reference="${prefix}Tibia_4">
        <sensor name="contact_sensor_4" type="contact">
            <always_on>true</always_on>
            <update_rate>50</update_rate>
            <contact>
                <collision>collision</collision>
            </contact>
        </sensor>
    </gazebo>

    <gazebo reference="${prefix}Tibia_5">
        <sensor name="contact_sensor_5" type="contact">
            <always_on>true</always_on>
            <update_rate>50</update_rate>
            <contact>
                <collision>collision</collision>
            </contact>
        </sensor>
    </gazebo>

    <gazebo reference="${prefix}Tibia_6">
        <sensor name="contact_sensor_6" type="contact">
            <always_on>true</always_on>
            <update_rate>50</update_rate>
            <contact>
                <collision>collision</collision>
            </contact>
        </sensor>
    </gazebo>
</robot>