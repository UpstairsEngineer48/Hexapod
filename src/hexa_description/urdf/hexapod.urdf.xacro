<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="hexapod">
    
    <xacro:arg name="package_name" default="hexa_description"/>
    <xacro:arg name="robot_name" default="hexapod"/>
    <xacro:arg name="prefix" default=""/>
    <xacro:arg name="config_dir" default="hexa_description"/>
    
    <xacro:property name="package_name" value="$(arg package_name)"/>
    <xacro:property name="robot_name" value="$(arg robot_name)"/>
    <xacro:property name="prefix" value="$(arg prefix)"/>
    <xacro:property name="config_dir" value="$(arg config_dir)"/>

    <xacro:include filename="materials.xacro"/>

    <!-- Visual colors, referenced by name in each link's <material> tag -->
    <material name="base_color">
        <color rgba="0.15 0.15 0.15 1.0"/>
    </material>
    <material name="coxa_color">
        <color rgba="0.10 0.35 0.75 1.0"/>
    </material>
    <material name="femur_color">
        <color rgba="0.85 0.45 0.05 1.0"/>
    </material>
    <material name="tibia_color">
        <color rgba="0.05 0.05 0.05 1.0"/>
    </material>

    <!-- ========================================== -->
    <!-- TRANSMISSION MACRO FOR HEXAPOD LEGS        -->
    <!-- ========================================== -->
    <xacro:macro name="leg_transmission" params="leg_num prefix">
        <!-- Coxa Joint (Base to Coxa) -->
        <transmission name="${prefix}Joint${leg_num}_1_tran">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${prefix}Joint${leg_num}_1">
                <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            </joint>
            <actuator name="${prefix}Joint${leg_num}_1_motor">
                <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
                <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>

        <!-- Femur Joint (Coxa to Femur) -->
        <transmission name="${prefix}Joint${leg_num}_2_tran">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${prefix}Joint${leg_num}_2">
                <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            </joint>
            <actuator name="${prefix}Joint${leg_num}_2_motor">
                <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
                <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>

        <!-- Tibia Joint (Femur to Tibia) -->
        <transmission name="${prefix}Joint${leg_num}_3_tran">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${prefix}Joint${leg_num}_3">
                <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            </joint>
            <actuator name="${prefix}Joint${leg_num}_3_motor">
                <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
                <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>
    </xacro:macro>
    <!-- ========================================== -->

    <!-- Minimal frames -->
    <link name="${prefix}base_footprint">
    </link>

    <link name="${prefix}base_link">
    </link>

    <joint name="${prefix}base_footprint_to_base_link" type="fixed">
        <parent link="${prefix}base_footprint"/>
        <child link="${prefix}base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Base link and mesh -->
    <link name="${prefix}Base">
        <inertial>
            <origin xyz="3.17137522879131E-06 -3.31180346009379E-06 0.0185997063575468" rpy="0 0 0"/>
            <mass value="0.516033712055295"/>
            <inertia ixx="0.00150227819625822" ixy="5.41358455149925E-09" ixz="-1.21815711093665E-09" iyy="0.000814451751266275" iyz="-4.64061267975536E-19" izz="0.00226054167247862"/>
        </inertial>
        
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://${package_name}/meshes/Base.STL"/>
            </geometry>
            <material name="base_color"/>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://${package_name}/meshes/Base.STL"/>
            </geometry>
        </collision>
    </link>

    <gazebo reference="${prefix}Base">
        <sensor name="imu_sensor" type="imu">
            <always_on>1</always_on>
            <update_rate>100</update_rate>
            <visualize>false</visualize>
            <topic>imu</topic>
        </sensor>
    </gazebo>

    <joint name="${prefix}base_link_to_Base" type="fixed">
        <parent link="${prefix}base_link"/>
        <child link="${prefix}Base"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Template for leg: Coxa/Femur/Tibia groups repeated 6x. Limits set to conservative defaults. -->

    <!-- Coxa 1 -->
    <link name="${prefix}Coxa_1">
        <inertial>
            <origin xyz="0.000577862012579221 -0.0317727763355633 0.0354243258351977" rpy="0 0 0"/>
            <mass value="0.058206986384816"/>
            <inertia ixx="2.09518881532946E-05" ixy="-5.83217116289199E-12" ixz="2.58985476936146E-06" iyy="1.97804446474374E-05" iyz="2.51053441650112E-06" izz="2.06393092896648E-05"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://${package_name}/meshes/Coxa_1.STL"/>
            </geometry>
            <material name="coxa_color"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://${package_name}/meshes/Coxa_1.STL"/>
            </geometry>
        </collision>
    </link>

    <joint name="${prefix}Joint1_1" type="revolute">
        <parent link="${prefix}Base"/>
        <child link="${prefix}Coxa_1"/>
        <origin xyz="0.067149 0.11215 0.05285" rpy="1.5708 0 2.3578"/>
        <axis xyz="0 -1 0"/>
        <limit lower="-1.5708" upper="1.5708" effort="5" velocity="2"/>
    </joint>


    <link name="${prefix}Femur_1">
        <inertial>
            <origin xyz="0.00548415363509747 -0.0355181600169509 0.0386098257844835" rpy="0 0 0"/>
            <mass value="0.10712888900759"/>
            <inertia ixx="5.18535588310174E-05" ixy="-1.40002219798617E-10" ixz="-5.13657075411247E-06" iyy="4.90722656444643E-05" iyz="2.0073057216516E-11" izz="1.67583851946084E-05"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://${package_name}/meshes/Femur_1.STL"/>
            </geometry>
            <material name="femur_color"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://${package_name}/meshes/Femur_1.STL"/>
            </geometry>
        </collision>
    </link>


    <joint name="${prefix}Joint1_2" type="revolute">
        <parent link="${prefix}Coxa_1"/>
        <child link="${prefix}Femur_1"/>
        <origin xyz="-0.03075 -0.03075 0.07" rpy="0 0 1.5708"/>
        <axis xyz="0 -1 0"/>
        <limit lower="-1.5708" upper="1.5708" effort="5" velocity="2"/>
    </joint>

    <link name="${prefix}Tibia_1">
        <inertial>
            <origin xyz="-0.0138680196135901 -0.0324549603873032 0.0624085311603042" rpy="0 0 0"/>
            <mass value="0.0754192114511324"/>
            <inertia ixx="8.21130142628132E-05" ixy="1.60749444883877E-08" ixz="3.75894773005154E-05" iyy="0.000101713737698438" iyz="2.38816460912834E-06" izz="4.78951327218008E-05"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://${package_name}/meshes/Tibia_1.STL"/>
            </geometry>
