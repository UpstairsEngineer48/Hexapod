        <axis xyz="0 -1 0"/>
        <limit lower="-1.5708" upper="1.5708" effort="5" velocity="2"/>
    </joint>

    <link name="${prefix}Femur_2">
        <inertial>
            <origin xyz="0.0142167130076838 -0.0347681597363993 0.0363193553535422" rpy="0 0 0"/>
