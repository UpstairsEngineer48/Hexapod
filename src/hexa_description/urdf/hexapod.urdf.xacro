                <mesh filename="package://${package_name}/meshes/Tibia_1.STL"/>
            </geometry>
        </collision>
    </link>


    <joint name="${prefix}Joint1_3" type="revolute">
        <parent link="${prefix}Femur_1"/>
        <child link="${prefix}Tibia_1"/>
        <origin xyz="0.011069 -0.00075 0.077211" rpy="0 -0.95571 0"/>
        <axis xyz="0 -1 0"/>
        <limit lower="-2.0" upper="0.5" effort="5" velocity="2"/>
    </joint>

    <!-- Coxa 2 -->
    <link name="${prefix}Coxa_2">
        <inertial>
            <origin xyz="0.000577862012579344 -0.0317727763355634 0.0354243258351973" rpy="0 0 0"/>
            <mass value="0.058206986384815"/>
            <inertia ixx="2.09518881532943E-05" ixy="-5.83217106619788E-12" ixz="2.58985476936139E-06" iyy="1.97804446474369E-05" iyz="2.51053441650115E-06" izz="2.06393092896644E-05"/>
