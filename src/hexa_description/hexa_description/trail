#!/usr/bin/env python3


import math
import rclpy
from rclpy.node import Node
from trajectory_msgs.msg import JointTrajectory, JointTrajectoryPoint
from builtin_interfaces.msg import Duration

JOINT_NAMES = []
for leg in range(1, 7):
    JOINT_NAMES += [f"hexa_Joint{leg}_1", f"hexa_Joint{leg}_2", f"hexa_Joint{leg}_3"]

PUBLISH_PERIOD_SEC = 1.0     # publish a fresh goal once per second (not 100Hz)
GOAL_DURATION_SEC = 1.0      # give the controller a full second to get there


class LegTest(Node):
    def __init__(self):
        super().__init__("leg_test")

        self.cmd_pub = self.create_publisher(
            JointTrajectory,
            "/hexapod_joint_trajectory_controller/joint_trajectory",
            10
        )

        self.timer = self.create_timer(
            0.01,
            self.control_loop
        )
        self.get_logger().info("Leg test node started — commanding leg 1 to 10 deg on all 3 joints.")

    def control_loop(self):
        positions = [0.0] * len(JOINT_NAMES)

        # Leg 1 = indices 0,1,2
        angle = -1*math.radians(50)
        positions[3] = -1*angle
        positions[4] = angle
        positions[5] = angle

        msg = JointTrajectory()
        msg.joint_names = JOINT_NAMES

        point = JointTrajectoryPoint()
        point.positions = positions
     

        msg.points = [point]
        self.cmd_pub.publish(msg)
        self.get_logger().info("Published goal: leg 1 -> 10deg on all 3 joints.")


def main(args=None):
    rclpy.init(args=args)
    node = LegTest()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    node.destroy_node()
    rclpy.shutdown()


if __name__ == "__main__":
    main()