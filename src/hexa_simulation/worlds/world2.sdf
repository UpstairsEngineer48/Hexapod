<?xml version="1.0"?>

<sdf version="1.8">

  <world name="default">

    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>0</real_time_factor>
      <real_time_update_rate>0</real_time_update_rate>
    </physics>

    <!-- ContactPrinter disabled: library was previously failing to load. -->
    <!--
    <plugin filename="libContactPrinter.so" name="ContactPrinter"/>
    -->

    <!-- Physics system: required -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
    </plugin>

    <!-- Contact system: required for the six contact sensors -->
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact">
    </plugin>

    <!-- UserCommands disabled for headless RL training -->
    
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
    </plugin>
    

    <!-- SceneBroadcaster disabled for headless RL training -->
    
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    

    <!-- Sensors system: required for the IMU -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <direction>-0.5 0.5 -1</direction>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <model name="ground_plane">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>

      </link>
    </model>

    <!-- ============================================= -->
    <!-- STATIC ROBOT INCLUDE                           -->
    <!-- Robot is loaded directly from the model.      -->
    <!-- ============================================= -->

    <include>
      <uri>model://hexapod_test_model</uri>
      <pose>0.0 0.0 0.4550 0 0 1.57</pose>
      <name>hexa</name>
    </include>

  </world>

</sdf>